{{/* macOS-only setup: laptop vs desktop from the hardware model. */}}
{{- $device_type := "desktop" -}}
{{- if contains "MacBook" (output "sysctl" "-n" "hw.model") -}}
{{-   $device_type = "laptop" -}}
{{- end -}}

{{/* promptStringOnce keeps the stored value as the default on re-init. */}}
{{- $email := promptStringOnce . "email" "Email address" -}}

[data]
  email = {{ $email | quote }}
  device_type = {{ $device_type | quote }}

{{/* VS Code as the three-way merge tool. It needs a real base file, which
     chezmoi does not supply, so copy .Target to a .base sidecar first. The
     merged result is written back to .Source. The inner {{ }} are emitted
     verbatim via a raw string so they are evaluated by `chezmoi merge`,
     not when this config template is rendered. */}}
[merge]
  command = "bash"
  args = [
    "-c",
    {{ `"cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}"` }},
  ]
